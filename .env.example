# ===================================================
#           TIKTOK SOFT CONFIGURATION TEMPLATE
# ===================================================

# 1. Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Telegram API Credentials (from https://my.telegram.org)
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# 3. Bot Administrator IDs (comma-separated list of Telegram User IDs)
ADMIN_ID=1452374962,5293338435

# 4. AI API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# 5. Database URL (PostgreSQL from Supabase / Neon / Render for persistent cloud storage)
# Leave empty for local SQLite (tiktok_soft.db)
DATABASE_URL=postgresql://user:password@host:port/database

# 6. S3-compatible Cloud Storage (Backblaze B2 / Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# 7. Video Assets Paths (relative to root or absolute)
BANNER_PATH=banner_video_tiktok/IMG_9654.MOV
BAIT_PATH=bait_soxr/bait.mp4

# 8. Optional: Archive Channel ID (for automated cross-posting to Telegram channel)
# ARCHIVE_CHANNEL_ID=-1001234567890

# 9. Optional: YouTube Cookies (Netscape format string for cloud server hosting)
# YOUTUBE_COOKIES=

# 10. WebApp Port (Render injects PORT automatically)
PORT=8085

# 11. Telegram Mini App Public HTTPS URL (Render, Cloudflare Tunnel, ngrok or domain)
# Example: WEBAPP_URL=https://my-bot-studio.onrender.com
WEBAPP_URL=
